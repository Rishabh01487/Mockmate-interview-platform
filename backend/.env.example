# ──────────────────────────────────────────────────
#  MockMate Backend — Production Environment Variables
#  Set ALL of these in your Render dashboard
# ──────────────────────────────────────────────────

NODE_ENV=production

# MongoDB Atlas connection string
# Get from: cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mockmate?retryWrites=true&w=majority

# JWT Secret — any long random string (64+ chars)
JWT_SECRET=replace-with-a-very-long-random-secret-string

# AI API — OpenAI-compatible endpoint (set your API key and model)
AI_API_URL=https://api.deepseek.com/v1
AI_API_KEY=sk-2eb60e010747407795d24dbf5516197b
AI_MODEL=deepseek-v4-flash

# Your Vercel frontend URL (for CORS)
CLIENT_URL=https://your-app.vercel.app
