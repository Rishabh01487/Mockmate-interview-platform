# ──────────────────────────────────────────────────────────
#  MockMate — Backend Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to git!
# ──────────────────────────────────────────────────────────

# MongoDB Atlas connection string (required for production)
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/mockmate?retryWrites=true&w=majority

# JWT signing secret — generate a random 64-char string
JWT_SECRET=change-me-to-a-long-random-secret-string

# Ollama / SambaNova Cloud API key
OLLAMA_API_KEY=your-api-key-here
OLLAMA_API_URL=https://ollama.com

# Frontend origin (Vercel automatically provides VERCEL_URL, so this is optional on Vercel)
# CLIENT_URL=https://your-app.vercel.app

# Node environment
NODE_ENV=production
